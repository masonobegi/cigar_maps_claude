node_modules/
server/data/
# 39MB of embedded Postgres. Local only, and never a thing to commit.
server/.pglite-data/
**/.pglite-data/
scraper/results/
scraper/node_modules/
.env
*.db
*.db-shm
*.db-wal
dist/
.DS_Store
Thumbs.db

# Claude Code per-machine settings: holds local permission rules, which here
# included a login command with a password. Never commit it.
.claude/settings.local.json

# The evidence archive, unpacked. sweeps/evidence.tar.gz is the committed copy;
# the extracted files are 30 MB of the same bytes.
sweeps/evidence/

# Licence registry downloads: 27 MB of public data that `licenceSync fetch`
# re-creates in a minute. The matched result (decisions/licences.json) is kept.
sweeps/decisions/licences/*.json

# Registry extracts: tens of megabytes, and `licenceSync fetch` re-downloads them.
sweeps/decisions/licences/*.csv
