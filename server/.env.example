# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection. Leave unset for local development and the server uses an
# embedded PGlite database in server/data/pglite (no install needed).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Core ────────────────────────────────────────────────────────────────────
JWT_SECRET=any-long-random-string-here
# Seeded staff logins. Leave unset in production and one-time random passwords
# are generated and printed in the boot log. Never put a real password here:
# this repository is public.
ADMIN_PASSWORD=
STAFF_PASSWORD=
STAFF_EMAIL=
PORT=3001
# Public URL, used in every emailed link
APP_URL=https://cigarbuddy.com

# ─── Transactional email ─────────────────────────────────────────────────────
# Gmail app password today; move to Resend or Postmark on a real domain.
# Without these, password reset and claim links are written to the server log
# instead of being sent, so the flows still work locally.
SMTP_USER=
SMTP_PASS=
# Where store claims that need a human land
ADMIN_EMAIL=mason.obegi@gmail.com

# ─── Image storage ───────────────────────────────────────────────────────────
# Any S3-compatible bucket (Cloudflare R2 is the cheap default). When these are
# unset, uploads go to server/uploads and are served at /uploads; on Railway
# that needs a mounted volume to survive a redeploy.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket, if it has one
S3_PUBLIC_BASE_URL=
# Local upload directory override
UPLOAD_DIR=

# ─── Billing (paid placement) ────────────────────────────────────────────────
# Without a secret key the plans page still renders and reports billing as off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices created in the Stripe dashboard
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_PARTNER=

# ─── Google Sheets inventory sync ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT=

# ─── Background jobs ─────────────────────────────────────────────────────────
# 1 disables reverse-geocoding of listings that are missing a city
DISABLE_CITY_FILL=
# 1 disables reading shop websites for online menus
DISABLE_MENU_SCAN=
# 1 refuses local disk uploads (use when object storage is mandatory)
DISABLE_LOCAL_UPLOADS=
