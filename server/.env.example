# Copy this to server/.env — not to the repository root. It is read relative to
# the server source, so it is found whichever way the app is started.
#
# On Railway there is no .env: set these as service variables instead, and read
# back what the deployment actually has at /api/health/config.
#
# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection. Leave unset for local development and the server uses an
# embedded PGlite database in server/data/pglite (no install needed).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Core ────────────────────────────────────────────────────────────────────
# Signs every session token. UNSET IS NOT SAFE: the fallback is a string in this
# repository's public history, and account_type is read straight off the token —
# so anybody who can read the repo can mint an admin session. Any long random
# string will do; changing it signs everyone out, which is the only cost.
JWT_SECRET=any-long-random-string-here
# Seeded staff logins. Leave unset in production and one-time random passwords
# are generated and printed in the boot log. Never put a real password here:
# this repository is public.
ADMIN_PASSWORD=
STAFF_PASSWORD=
STAFF_EMAIL=
PORT=3001
# Public URL. Every emailed link, Stripe return, canonical tag, sitemap entry
# and outreach message is built from it, so set it the moment a real domain
# exists. Unset means the Railway subdomain the app shipped on.
APP_URL=https://cigarbuddy.com

# ─── Transactional email ─────────────────────────────────────────────────────
# HOW MAIL ACTUALLY LEAVES, on Railway and most platforms: over HTTPS, not SMTP.
# Outbound SMTP is not routed there at all (25, 465 and 587 all time out), so no
# SMTP provider can work however it is configured. Set ONE of these and mail
# goes out over port 443, which is never blocked:
RESEND_API_KEY=
POSTMARK_TOKEN=
# Postmark only: which stream to send on.
POSTMARK_STREAM=outbound

# The SMTP block below is for a host that does allow SMTP. It is ignored
# whenever one of the two keys above is set.
# Credentials alone mean Gmail, which is fine for a password reset and wrong for
# writing to shops: Gmail rate-limits, rewrites the From header to the account's
# own address, and treats a few hundred messages to strangers as what it looks
# like. Add SMTP_HOST to use a provider on your own domain instead.
SMTP_USER=
SMTP_PASS=
# Any provider: smtp.resend.com, smtp.postmarkapp.com, email-smtp.<region>.amazonaws.com
SMTP_HOST=
# 587 starts in the clear and upgrades (the usual choice); 465 is implicit TLS.
# secure is derived from the port, so this is rarely needed.
SMTP_PORT=587
SMTP_SECURE=
# Or a name nodemailer knows, instead of a host: gmail, outlook, zoho
SMTP_SERVICE=
# The From header. A provider on your own domain honours it; Gmail overwrites it.
MAIL_FROM=CigarBuddy <hello@example.com>
# Where store claims that need a human land
ADMIN_EMAIL=mason.obegi@gmail.com

# ─── Writing to shops (jobs/outreach.js) ─────────────────────────────────────
# The name a shop sees signing the message.
OUTREACH_FROM_NAME=Mason
# A postal address, which US commercial email is required to carry. Without it
# the message still sends and is still missing something the law asks for.
OUTREACH_POSTAL_ADDRESS=

# ─── Search engines and analytics ────────────────────────────────────────────
# The token from Search Console's "HTML tag" method — just the content value.
# Injected into the head of every page, the homepage included.
GOOGLE_SITE_VERIFICATION=
# The same from Bing Webmaster Tools.
BING_SITE_VERIFICATION=
# One of these, or neither. Plausible is a single script and no cookie banner;
# GA4 is free and heavier.
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=

# ─── Image storage ───────────────────────────────────────────────────────────
# Any S3-compatible bucket (Cloudflare R2 is the cheap default). When these are
# unset, uploads go to server/uploads and are served at /uploads; on Railway
# that needs a mounted volume to survive a redeploy.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket, if it has one
S3_PUBLIC_BASE_URL=
# Local upload directory override
UPLOAD_DIR=

# ─── Billing (paid placement) ────────────────────────────────────────────────
# Without a secret key the plans page still renders and reports billing as off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices created in the Stripe dashboard
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_PARTNER=

# ─── Google Sheets inventory sync ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT=

# ─── Background jobs ─────────────────────────────────────────────────────────
# 1 disables reverse-geocoding of listings that are missing a city
DISABLE_CITY_FILL=
# 1 disables reading shop websites for online menus
DISABLE_MENU_SCAN=
# 1 refuses local disk uploads (use when object storage is mandatory)
DISABLE_LOCAL_UPLOADS=
# 1 stops the nightly recomputation of which listings are public
DISABLE_VERIFIED_SET=
# 1 skips the demo data a fresh empty database would otherwise be seeded with
DISABLE_DEMO_SEED=
